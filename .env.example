# Phase 8 (backend PRD §11 row 8) — pipeline.direct pulls confirmed direct
# orders from the-oven-vibe-backend's D1 database via the deployed Worker.
#
# Copy this file to `.env` and fill in the real value (see
# ~/workbench/the-oven-vibe/CREDENTIALS.local.md, which sits outside every
# git repo, for the current ADMIN_TOKEN). `.env` is gitignored — never commit
# the real token.
#
# main.py / watch_pipeline.py don't auto-load .env (no dotenv dependency
# added for one variable) — export it in your shell before running, e.g.:
#   set -a; source .env; set +a; uv run python main.py

# Defaults to the live Worker; override only for local dev against
# `wrangler dev`.
OVEN_VIBE_WORKER_URL=https://api.theovenvibe.com

# Required. Same ADMIN_TOKEN gating the backend's /admin/* routes.
OVEN_VIBE_ADMIN_TOKEN=

# Cloudflare Access service token — the unattended way past Access.
#
# Without these two, the pipeline reads the CF_Authorization cookie out of your
# signed-in browser, which means a browser has to exist, be signed in, and be
# closed. That cannot run from a timer. With them, no browser is involved at
# all. Create them in the Cloudflare dashboard: Zero Trust -> Access ->
# Service Auth -> Create Service Token, then add the token to the /admin
# application's policy. Full steps in docs/UNATTENDED-SYNC.md.
#
# The client secret is shown once, at creation. Both go in .env (gitignored)
# and in ~/workbench/the-oven-vibe/CREDENTIALS.local.md.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
